{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formai.studio/catalog/v1/schema/package.schema.json",
  "title": "formai package manifest (.formpkg)",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "id",
    "name",
    "product",
    "kind",
    "version",
    "author",
    "licence",
    "native",
    "permissions"
  ],
  "additionalProperties": true,
  "properties": {
    "format": {
      "const": "formai-package"
    },
    "format_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "enum": [
        "formvis",
        "formcut",
        "formwav",
        "formpdf",
        "formdeck",
        "formlit",
        "formmd",
        "formencoder",
        "formvfx",
        "formmcp",
        "formtray",
        "formskills",
        "formportal"
      ]
    },
    "kind": {
      "$ref": "#/$defs/kind"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "minimum_app": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "native": {
      "type": "boolean"
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "payload": {
      "type": "string",
      "minLength": 1
    },
    "api": {
      "const": "1"
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://"
    },
    "support": {
      "type": "string",
      "pattern": "^https://"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui": {
          "$ref": "#/$defs/relpath"
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panels": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/local"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "location": {
                "enum": [
                  "dock",
                  "dialog"
                ]
              }
            }
          }
        },
        "commands": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/local"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "panel": {
                "$ref": "#/$defs/local"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "kind": {
      "enum": [
        "effect-stack",
        "wgsl-kernel",
        "audio-chain",
        "caption-look",
        "lut",
        "timeline-template",
        "script-plugin",
        "action-set",
        "preset",
        "theme",
        "native-plugin"
      ]
    },
    "permission": {
      "enum": [
        "document",
        "files-read",
        "files-write",
        "network",
        "models",
        "native-code"
      ]
    },
    "local": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "relpath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]{1,200}$"
    }
  }
}