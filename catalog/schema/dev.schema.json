{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formai.studio/catalog/v1/schema/dev.schema.json",
  "title": "form.ext development extensions (per product)",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "product",
    "extensions"
  ],
  "properties": {
    "format": {
      "const": "formext-dev-extensions"
    },
    "format_version": {
      "const": 1
    },
    "product": {
      "enum": [
        "formvis",
        "formcut",
        "formwav",
        "formpdf",
        "formdeck",
        "formlit",
        "formmd",
        "formencoder",
        "formvfx",
        "formmcp",
        "formtray",
        "formskills",
        "formportal"
      ]
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "added": {
            "type": "string"
          }
        }
      }
    }
  }
}