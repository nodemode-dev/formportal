{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formai.dev/catalog/v1/schema/products.schema.json",
  "title": "formai product registry",
  "type": "object",
  "required": ["format", "format_version", "products"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "formai-products" },
    "format_version": { "const": 1 },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "summary", "identifier", "repository", "licence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "pattern": "^[a-z][a-z-]{1,23}$" },
          "status": { "enum": ["available", "in-progress", "in-development"] },
          "group": { "enum": ["adobe", "other", "next"] },
          "alt_of": { "type": "string", "maxLength": 60 },
          "note": { "type": "string", "maxLength": 80 },
          "summary": { "type": "string", "minLength": 1 },
          "identifier": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
          "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
          "licence": { "type": "string" },
          "project_extensions": { "type": "array", "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" } },
          "minimum_os": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "macos": { "type": "string" },
              "windows": { "type": "string" },
              "linux": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
