#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/.."

command -v cargo >/dev/null || { echo "Rust is required: https://rustup.rs"; exit 1; }
( cd frontend && npm ci && npm run build )
cd src-tauri
npx --yes @tauri-apps/cli@2.12.3 build --bundles deb,rpm,appimage "$@"
echo "Built into $(cd .. && pwd)/target/release/bundle"
