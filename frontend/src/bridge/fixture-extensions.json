  "packages": [
    {
      "id": "halftone-separations",
      "name": "Halftone Separations",
      "product": "formvis",
      "kind": "script-plugin",
      "author": "nodemode",
      "description": "Splits the open picture into process CMYK or two to four spot-ink plates, screens each plate with its own angle, frequency and dot shape, previews the overprint on your paper colour, and adds the plates as Multiply layers in one undo step or saves them as PNG films for printing.",
      "version": "0.1.0",
      "url": "https://formai.studio/extensions/packages/halftone-separations-0.1.0.formpkg",
      "sha256": "5bb0a11bd13dfbb63efef8dbcc353fd5b3b7e3f398fe4591926128f480e3fa40",
      "bytes": 16288,
      "licence": "Apache-2.0",
      "minimum_app": "2.1.0",
      "native": false,
      "permissions": [
        "document",
        "files-write"
      ],
      "api": "1",
      "homepage": "https://formai.studio/extensions/#halftone-separations"
    },
    {
      "id": "shot-list",
      "name": "Shot List",
