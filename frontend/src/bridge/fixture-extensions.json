        "document"
      ],
      "api": "1",
      "homepage": "https://formai.studio/extensions/#handwriting-reveal"
    },
    {
      "id": "tool-diff",
      "name": "Tool Diff",
      "product": "formmcp",
      "kind": "script-plugin",
      "author": "nodemode",
      "description": "Keeps snapshots of each Form app's tool list as formMCP sees it, or imports a saved tools/list with argument schemas, and compares any two: added, removed, renamed and changed tools and arguments, with breaking changes flagged, saved as an HTML or JSON report. Agents can run Check for Tool Changes to hear what changed since the last snapshot.",
      "version": "0.1.1",
      "url": "https://formai.studio/extensions/packages/tool-diff-0.1.1.formpkg",
      "sha256": "bf4d0a4eabff933c6e464535b3cb0fba4794aa1118ef123d3a0df6baf93979d7",
      "bytes": 14925,
      "licence": "Apache-2.0",
