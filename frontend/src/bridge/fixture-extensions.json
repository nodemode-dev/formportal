    {
      "id": "citations",
      "name": "Citations",
      "product": "formmd",
      "kind": "script-plugin",
      "author": "nodemode",
      "description": "Imports a BibTeX or CSL-JSON reference library, inserts citation keys such as [@smith2020, p. 12] at the cursor, shows every citation in the page with its in-text form, and builds or updates an APA, Chicago author-date or IEEE bibliography at the end of the page as one undo step.",
      "version": "0.1.1",
      "url": "https://formai.studio/extensions/packages/citations-0.1.1.formpkg",
