      "homepage": "https://formai.studio/extensions/#tool-diff"
    },
    {
      "id": "focus-timer",
      "name": "Focus Timer",
      "product": "formtray",
      "kind": "script-plugin",
      "author": "nodemode",
      "description": "A Widgets board tile for focused work: run focus sessions and short and long breaks, add a note to what you are working on, see today's sessions and a seven-day chart of focus minutes against a daily goal, with an optional chime and a toast when a session ends. Sessions keep running when the tile reloads. Needs no permissions.",
      "version": "0.1.0",
      "url": "https://formai.studio/extensions/packages/focus-timer-0.1.0.formpkg",
      "sha256": "d1e72e664e6bde8b2fe4e7b5c92278d4a6ec7517fc1c532d8fb462c58fbd3804",
      "bytes": 11100,
      "licence": "Apache-2.0",
      "minimum_app": "0.15.0",
      "native": false,
      "permissions": [],
      "api": "1",
      "homepage": "https://formai.studio/extensions/#focus-timer"
    },
    {
      "id": "trigger-tester",
      "name": "Trigger Tester",
      "product": "formskills",
      "kind": "script-plugin",
      "author": "nodemode",
      "description": "Paste or load sample prompts and see which skill each one would trigger. An offline BM25 model of the skills' names and descriptions ranks every skill per prompt, flags pairs that fight for the same prompts, finds skills that never win, lets you try a new description and save it to your copy in one undo step, and saves the report as Markdown or JSON.",
      "version": "0.1.0",
      "url": "https://formai.studio/extensions/packages/trigger-tester-0.1.0.formpkg",
      "sha256": "f47752d1a7768aff8fbefed34b77699482862c2c2debc044fde0d36378b0abfb",
      "bytes": 17733,
      "licence": "Apache-2.0",
      "minimum_app": "0.9.0",
      "native": false,
      "permissions": [
        "document",
        "files-read",
        "files-write"
      ],
      "api": "1",
      "homepage": "https://formai.studio/extensions/#trigger-tester"
    }
