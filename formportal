#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"

case "${1:-}" in
  mcp|cli)
    [ "$1" = "mcp" ] || shift
    bin=target/release/formportal-cli
    if [ ! -x "$bin" ] || [ -n "$(find cli/src core/src -newer "$bin" -name '*.rs' 2>/dev/null | head -1)" ]; then
      cargo build -q --release --locked -p formportal-cli >&2
    fi
    exec "$bin" "$@"
    ;;
  agents)
    exec python3 setup/agents.py "${@:2}"
    ;;
esac

command -v cargo >/dev/null || { echo "Rust is required: https://rustup.rs. Then run ./formportal_oc_install"; exit 1; }
[ -d frontend/node_modules ] || { echo "Run ./formportal_oc_install first."; exit 1; }

set -m
interface=
stop() {
  trap - EXIT INT TERM
  [ -n "$interface" ] && kill -- "-$interface" 2>/dev/null || true
}
trap stop EXIT INT TERM

( cd frontend && ./boot_frontend ) &
interface=$!

for _ in $(seq 1 100); do
  (exec 3<>/dev/tcp/localhost/3250) 2>/dev/null && break
  sleep 0.2
done

cargo run -p formportal
